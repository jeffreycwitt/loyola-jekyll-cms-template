# Copy to .env and fill in values for local development.
# .env is gitignored — never commit real credentials.

# Default when unset: http://localhost:3000
CMS_URL=https://loyola-cms.jeffreycwitt.com

CMS_EMAIL=you@example.com
CMS_PASSWORD=yourpassword

# Optional: filter posts to a specific group name (e.g. FA26_FR365)
# CMS_GROUP=
